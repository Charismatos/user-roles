# ==============================================================================
# LARAVEL DUSK ENVIRONMENT CONFIGURATION (.env.dusk.local)
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Configuration
# ------------------------------------------------------------------------------
APP_ENV=dusk
APP_KEY=base64:caqY8IRLLCfy1X2DclfhhMo0vLzG0317Nsf9hcwpZOU=
APP_DEBUG=true
# Dusk runs a real browser, so this MUST match your local web server / VirtualHost URL
APP_URL=http://localhost.testing.local
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FAKER_LOCALE=en_US

# ------------------------------------------------------------------------------
# Driver & Performance Optimizations for Browser Testing
# ------------------------------------------------------------------------------
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=4
HASH_DRIVER=bcrypt

# Log browser errors for debugging failing Dusk assertions
LOG_CHANNEL=single
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# Use a dedicated database to prevent Dusk tests from wiping development data
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=user-roles-dusk
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_STRICT_MODE=true

# ------------------------------------------------------------------------------
# Session & Cookie Configuration
# ------------------------------------------------------------------------------
# Dusk requires a persistent session driver so the browser can maintain state across HTTP requests
SESSION_DRIVER=file
SESSION_ENCRYPT=false
SESSION_LIFETIME=120

# ------------------------------------------------------------------------------
# Cache & Queue Driver Configuration
# ------------------------------------------------------------------------------
# Use array or file cache; sync queue ensures background jobs run immediately in-process
CACHE_STORE=array
QUEUE_CONNECTION=sync

# ------------------------------------------------------------------------------
# Mail & Notifications
# ------------------------------------------------------------------------------
# Log outgoing emails so you can inspect generated mailables during browser flows
MAIL_MAILER=log
MAIL_FROM_ADDRESS=userroles@dusk.local
MAIL_FROM_NAME="Base Laravel Dusk"

# ------------------------------------------------------------------------------
# Filesystem Configuration
# ------------------------------------------------------------------------------
FILESYSTEM_DISK=local

# ------------------------------------------------------------------------------
# Selenium / Webdriver Remote Server Configuration
# ------------------------------------------------------------------------------
# Point Dusk to your running Standalone Selenium Server or Grid container
DUSK_DRIVER_URL=http://localhost:4444/wd/hub

# Browser binary target (chrome, firefox, edge, safari)
DUSK_BROWSER=chrome

# Set to true if running Selenium in a headless Docker/CI environment
DUSK_HEADLESS=false

# Selenium Options
SELENIUM_HOST=127.0.0.1
SELENIUM_PORT=4444

# ------------------------------------------------------------------------------
# Security, Rate Limiting & Developer Tools
# ------------------------------------------------------------------------------
RATE_LIMITER_DISABLED=true
THROTTLE_ENABLED=false
TELESCOPE_ENABLED=false
HORIZON_ENABLED=false